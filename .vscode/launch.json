{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Запустить сервер (Node.js)",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/Server/dist/index.js",  // путь к вашему entry point
            "outFiles": ["${workspaceFolder}/Server/dist/**/*.js"],
            "runtimeArgs": ["--inspect"],
            "cwd": "${workspaceFolder}/Server",
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:18545",
            "webRoot": "${workspaceFolder}"
        }
    ]
}